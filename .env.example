POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://newsbot:change-me-local-only@localhost:5432/newsbot?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=replace-with-a-long-random-token
# openai | google (gemini is also accepted)
AI_PROVIDER=openai
# Empty means same provider as AI_PROVIDER; can select independently.
TTS_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_TEXT_MODEL=gemini-3.8-flash
GOOGLE_TTS_MODEL=gemini-3.8-flash-tts
GOOGLE_VOICE=Kore
OUTPUT_DIR=./data/videos
HTTP_ADDR=127.0.0.1:8080
COLLECT_INTERVAL=5m
WEB_ORIGIN=http://localhost:3000

# Google 3.8 TTS: automatic topic styles and cached Voice Design
TTS_AUTO_STYLE=true
GOOGLE_VOICE_DESIGN=true
# Optional overrides; equivalent variables work for each source category
GOOGLE_VOICE_ID_HEALTH=
GOOGLE_VOICE_PROMPT_HEALTH=
GOOGLE_SPEECH_STYLE_HEALTH=
GOOGLE_VOICE_ID_TECHNOLOGY=
GOOGLE_VOICE_PROMPT_TECHNOLOGY=
GOOGLE_SPEECH_STYLE_TECHNOLOGY=

# Check each Google audio scene before muxing; extra audio-understanding requests
GOOGLE_VERIFY_VIETNAMESE=false
# Empty defaults to GOOGLE_TEXT_MODEL; requires audio-input support
GOOGLE_AUDIO_CHECK_MODEL=
