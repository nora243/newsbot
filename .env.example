POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://newsbot:change-me-local-only@localhost:5432/newsbot?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=replace-with-a-long-random-token
# openai | google (gemini is also accepted)
AI_PROVIDER=openai
# Empty means same provider as AI_PROVIDER; can select independently.
TTS_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_TEXT_MODEL=gemini-3.8-flash
GOOGLE_TTS_MODEL=gemini-3.8-flash-tts
GOOGLE_VOICE=Kore
OUTPUT_DIR=./data/videos
HTTP_ADDR=127.0.0.1:8080
COLLECT_INTERVAL=5m
WEB_ORIGIN=http://localhost:3000
